{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "派蒙助手",
  "version": "0.1.0",
  "identifier": "io.github.kazeliu.paimon-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "派蒙助手",
        "width": 1380,
        "height": 860,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "devtools": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../../logo.png"],
    "resources": ["../resources/**/*"]
  }
}
